{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"if (!/pnpm/.test(process.env.npm_config_user_agent || '')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "dev": "pnpm --filter @workspace/huntiq run dev",
    "server": "pnpm --filter @workspace/api-server run dev",
    "dev:server": "pnpm --filter @workspace/api-server run dev",
    "dev:huntiq": "pnpm --filter @workspace/huntiq run dev",
    "dev:all": "pnpm --parallel --filter @workspace/huntiq --filter @workspace/api-server run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@netlify/functions": "^6.0.0",
    "@replit/connectors-sdk": "^0.4.1",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
