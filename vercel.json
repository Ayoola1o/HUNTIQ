{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/huntiq/dist/public",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "artifacts/api-server/src/database/migrations/*.sql",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/renew-watches",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/campaigns",
      "schedule": "*/5 * * * *"
    }
  ]
}
