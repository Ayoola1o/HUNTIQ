# HUNTIQ Environment Configuration Template

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/huntiq

# Authentication & Security
JWT_SECRET=your_production_jwt_secret_change_me
API_KEY=your_api_key_for_external_clients

# Map & Geospatial Services
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Apify Google Maps Place Discovery
APIFY_API_TOKEN=
APIFY_MAPS_ACTOR_ID=scrapeai~google-maps-places-scraper
HUNTIQ_MAPS_MOCK=false
MAPS_MAX_RESULTS=50
MAPS_MAX_RADIUS_KM=50
MAPS_MAX_CONCURRENT_JOBS=3
